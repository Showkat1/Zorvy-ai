# =============================================================================
# Zorvy — environment configuration
# Copy to `.env` and adjust values. Never commit the real `.env`.
# =============================================================================

# --- Compose / infrastructure ------------------------------------------------
POSTGRES_USER=zorvy
POSTGRES_PASSWORD=zorvy
POSTGRES_DB=zorvy
POSTGRES_PORT=5432

API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Application -------------------------------------------------------------
# development | test | production
ZORVY_ENVIRONMENT=development
ZORVY_DEBUG=false
ZORVY_APP_NAME=Zorvy
ZORVY_API_V1_PREFIX=/api/v1
ZORVY_FRONTEND_URL=http://localhost:3000
ZORVY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ZORVY_SECRET_KEY=change-me-to-a-long-random-string-at-least-48-characters
ZORVY_ACCESS_TOKEN_MINUTES=15
ZORVY_REFRESH_TOKEN_DAYS=30
ZORVY_PASSWORD_MIN_LENGTH=10
# Must be true (HTTPS only) in production.
ZORVY_COOKIE_SECURE=false
ZORVY_COOKIE_DOMAIN=
ZORVY_RATE_LIMIT_ENABLED=true
ZORVY_AUTH_RATE_LIMIT_PER_MINUTE=12
ZORVY_INVESTIGATION_RATE_LIMIT_PER_MINUTE=20
ZORVY_DEVICE_SCAN_RATE_LIMIT_PER_MINUTE=30

# --- Database ----------------------------------------------------------------
# Local (outside Docker):
ZORVY_DATABASE_URL=postgresql+asyncpg://zorvy:zorvy@localhost:5432/zorvy
# SQLite fallback for a zero-dependency demo:
# ZORVY_DATABASE_URL=sqlite+aiosqlite:///./zorvy.db
ZORVY_DATABASE_ECHO=false
# Let the app create tables on startup. Disable in production and use Alembic.
ZORVY_AUTO_CREATE_TABLES=true

# --- Uploads -----------------------------------------------------------------
ZORVY_UPLOAD_DIR=uploads
ZORVY_MAX_UPLOAD_SIZE_MB=10
ZORVY_MAX_TEXT_CHARACTERS=20000
ZORVY_RETENTION_DAYS=90

# --- LLM ---------------------------------------------------------------------
# Leave ZORVY_LLM_API_KEY empty to run the deterministic fallback engine.
ZORVY_LLM_ENABLED=true
ZORVY_LLM_PROVIDER=openrouter
ZORVY_LLM_API_KEY=
ZORVY_LLM_BASE_URL=https://openrouter.ai/api/v1
ZORVY_LLM_MODEL=openrouter/free
ZORVY_LLM_TIMEOUT_SECONDS=45
ZORVY_LLM_MAX_RETRIES=2

# --- Embeddings / RAG --------------------------------------------------------
# openai | sentence-transformers | hash
ZORVY_EMBEDDING_PROVIDER=hash
ZORVY_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ZORVY_EMBEDDING_DIM=384
ZORVY_RAG_TOP_K=4
ZORVY_RAG_MIN_SCORE=0.05
ZORVY_KNOWLEDGE_DIR=data/knowledge_base
ZORVY_SEED_KNOWLEDGE_ON_STARTUP=true

# --- OCR ---------------------------------------------------------------------
ZORVY_OCR_ENABLED=true
# ZORVY_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Pipeline ----------------------------------------------------------------
# background (production) | inline (tests / single-process demos)
ZORVY_PIPELINE_MODE=background
ZORVY_PIPELINE_TIMEOUT_SECONDS=180

# --- Observability -----------------------------------------------------------
ZORVY_LOG_LEVEL=INFO
ZORVY_LOG_JSON=false
ZORVY_SENTRY_DSN=
